  "questions": [
    {
      "id": "q1",
      "title": "CÂU HỎI 1: Hành vi nào có vấn đề?",
      "description": "Xác định cụ thể hành vi chưa đúng hoặc tiềm ẩn rủi ro trong tình huống.",
      "placeholder": "Nhập câu trả lời của nhóm... (Ví dụ: Hành vi tải phần mềm không rõ nguồn gốc, sử dụng bản bẻ khóa là vi phạm...)",
      "guideline": "Chỉ rõ hành vi vi phạm pháp luật hoặc chuẩn mực đạo đức số trong tình huống được giao."
    },
    {
      "id": "q2",
      "title": "CÂU HỎI 2: Quyền lợi của tác giả có thể bị ảnh hưởng như thế nào?",
      "description": "Phân tích tác động đối với người sáng tạo (về tinh thần, kinh tế, uy tín).",
      "placeholder": "Nhập câu trả lời của nhóm... (Ví dụ: Tác giả không nhận được tiền bản quyền xứng đáng, bị mạo danh, giảm động lực sáng tạo...)",
      "guideline": "Phân tích cả quyền nhân thân (được đứng tên, bảo vệ sự toàn vẹn tác phẩm) và quyền tài sản (thu nhập)."
    },
    {
      "id": "q3",
      "title": "CÂU HỎI 3: Cần làm gì để sử dụng nội dung phù hợp?",
      "description": "Đề xuất giải pháp đúng đắn, hợp pháp và văn minh khi gặp tình huống tương tự.",
      "placeholder": "Nhập câu trả lời của nhóm... (Ví dụ: Mua bản quyền chính thức, dùng phần mềm mã nguồn mở miễn phí, xin phép tác giả...)",
      "guideline": "Nêu các bước cụ thể: mua bản quyền, xin phép, trích dẫn nguồn hoặc dùng tài nguyên giấy phép mở (Creative Commons)."
    }
  ],
